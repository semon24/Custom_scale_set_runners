ARG DIND_BASE=docker:dind
FROM ${DIND_BASE}

ARG RUNNER_IMAGE
LABEL preloaded.runner-image=${RUNNER_IMAGE}

RUN cat > /usr/local/bin/start-dind-with-preload.sh <<'EOF' && sed -i 's/\r$//' /usr/local/bin/start-dind-with-preload.sh && chmod +x /usr/local/bin/start-dind-with-preload.sh
#!/bin/sh

DOCKERD_ARGS=${DOCKERD_ARGS:-"--host=unix:///var/run/docker.sock --tls=false"}
RUNNER_TAR=${RUNNER_TAR:-/opt/preload/runner-image.tar}

dockerd-entrypoint.sh ${DOCKERD_ARGS} &
dockerd_pid=$!

cleanup() {
	if kill -0 "$dockerd_pid" >/dev/null 2>&1; then
		kill "$dockerd_pid" >/dev/null 2>&1 || true
	fi
}
trap cleanup INT TERM

ready=0
if ! command -v docker >/dev/null 2>&1; then
	echo "docker cli is not available in dind container" >&2
	exit 1
fi

i=0
while [ "$i" -lt 120 ]; do
	if docker info >/dev/null 2>&1; then
		ready=1
		break
	fi
	sleep 1
	i=$((i + 1))
done

if [ "$ready" -ne 1 ]; then
	echo "dockerd did not become ready in time" >&2
	exit 1
fi

if [ -f "$RUNNER_TAR" ]; then
	echo "Loading prepacked runner image from $RUNNER_TAR"
	docker load -i "$RUNNER_TAR"
else
	echo "Runner image tar was not found at $RUNNER_TAR, skipping preload"
fi

wait "$dockerd_pid"
EOF

# This tar is generated by build-preloaded-dind.sh from host Docker cache.
COPY runner-image.tar /opt/preload/runner-image.tar

# Default: run preload script. Scaler overrides with mkdir+chown+script.
ENTRYPOINT ["/usr/local/bin/start-dind-with-preload.sh"]
